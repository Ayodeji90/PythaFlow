ENV=dev
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- infra ---
# localhost for host runs; docker-compose overrides these for the api container.
DATABASE_URL=postgresql+asyncpg://concierge:concierge@localhost:5432/concierge
REDIS_URL=redis://localhost:6379/0

# --- LLM orchestration (provider-agnostic; swap freely) ---
# provider: nvidia | openai | groq | mistral | openai_compatible
LLM_PROVIDER=nvidia
# Put the key on its own line below — no quotes, no trailing comment.
# NVIDIA keys start with "nvapi-" (get a free one at build.nvidia.com).
LLM_API_KEY=
# Optional base-url override; leave blank to use the provider default.
LLM_BASE_URL=
LLM_MODEL_FAST=meta/llama-3.1-8b-instruct
LLM_MODEL_QUALITY=meta/llama-3.3-70b-instruct
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1024

# --- embeddings (wired in from Day 5) ---
EMBED_PROVIDER=nvidia
EMBED_MODEL=nvidia/nv-embedqa-e5-v5
EMBED_DIM=1024

# --- Azure AI Foundry multi-model failover -------------------------------------
# To switch the concierge onto Foundry, change LLM_PROVIDER (above) to:
#     LLM_PROVIDER=azure_failover
# Then fill in up to 3 deployments below. The router tries #1, and on error OR
# after AZURE_FOUNDRY_ATTEMPT_TIMEOUT seconds, falls over to #2, then #3.
# If all three live under ONE Foundry resource, use the SAME endpoint + key for
# each and only change the MODEL (the deployment name from your Deployments list).
AZURE_FOUNDRY_1_ENDPOINT=
AZURE_FOUNDRY_1_KEY=
AZURE_FOUNDRY_1_MODEL=DeepSeek-V4-Pro
AZURE_FOUNDRY_2_ENDPOINT=
AZURE_FOUNDRY_2_KEY=
AZURE_FOUNDRY_2_MODEL=grok-4-20-non-reasoning
AZURE_FOUNDRY_3_ENDPOINT=
AZURE_FOUNDRY_3_KEY=
AZURE_FOUNDRY_3_MODEL=Kimi-K2.6
# Azure AI Inference endpoints (…/models) require this; leave BLANK if your
# endpoint is a plain OpenAI-compatible route (…/openai/v1). Match what the
# Foundry deployment's "Endpoint / Consume" page shows.
AZURE_FOUNDRY_API_VERSION=2024-05-01-preview
# Seconds to wait on a model before routing to the next one.
AZURE_FOUNDRY_ATTEMPT_TIMEOUT=30

# --- WhatsApp / Twilio (Day 15) — no Meta business verification needed ---
# From console.twilio.com → Messaging → Try it out → WhatsApp Sandbox.
# Point the sandbox "When a message comes in" webhook at:
#     https://<your-public-url>/webhooks/whatsapp     (use ngrok/cloudflared for local)
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Route sandbox messages to this tenant when no whatsapp Channel matches the "To":
WHATSAPP_DEFAULT_TENANT=demo

# --- Telegram (Bot API) — one bot per venue, created via @BotFather ---
# The bot token is the ONLY credential and is stored per-venue on the tenant's
# Telegram Channel row (Channel.config["bot_token"]) — NOT in env. Seed it in:
#     TELEGRAM_BOT_TOKEN=<token> TELEGRAM_BOT_USERNAME=@venuebot uv run python scripts/seed.py
# Receiving is webhook-only: register each bot at /webhooks/telegram/{tenant_slug}
# via POST /webhooks/telegram/set with {tenant_slug, url} (tunnel for local dev).
# Optional global fallback webhook secret (per-venue secrets are per-channel):
TELEGRAM_WEBHOOK_SECRET=
# Sandbox fallback: the shared POST /webhooks/telegram path routes to this tenant
# slug. Blank = discard — production uses the per-tenant path, so blank is safe.
TELEGRAM_DEFAULT_TENANT=demo
